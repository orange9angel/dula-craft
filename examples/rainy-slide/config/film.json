    },
    "frog": {
      "desc": "一个大约十岁的男孩，声音明亮略带沙哑，胸腔放松，气息足，语速快，爽朗"
    }
  },
  "lines": [
    {
      "id": "l01",
      "who": "snail",
      "text": "要下雨了……我最怕雨了！",
      "delivery": "发抖，声音发紧，最后三个字带一点哭腔"
    },
    {
      "id": "l02",
      "who": "frog",
      "text": "怕什么？地湿了才好滑呢！",
      "delivery": "轻松地笑着说，像在逗朋友，结尾上扬"
    },
    {
      "id": "l03",
      "who": "snail",
      "text": "咦？好滑！",
      "delivery": "紧凑，先轻轻疑惑一声“咦”，只停半拍，马上清清楚楚、响亮惊喜地说“好滑”，每个字都咬清",
      "mouth_open_at": 0.25
    },
    {
      "id": "l04",
      "who": "snail",
      "text": "哇，我飞起来啦！",
      "delivery": "放开嗓子，兴奋大喊，一口气冲到句尾",
      "mouth_open_at": 0.25
    },
    {
      "id": "l05",
      "who": "frog",
      "text": "等等我！",
      "delivery": "边跑边喊，有点喘，笑着"
    }
  ],
